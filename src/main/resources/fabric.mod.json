{
  "schemaVersion": 1,
  "id": "wellfeed",
  "version": "${version}",
  "name": "Wellfeed",
  "description": "A click-GUI utility menu with keybinds, per-module settings and automation helpers (AutoMine, AutoBuild, AutoFarm, AutoFish, AutoEat, AutoTool).",
  "authors": ["Wellfeed contributors"],
  "license": "MIT",
  "icon": "assets/wellfeed/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.wellfeed.WellfeedClient"]
  },
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
